From: UgLy|OS
Subject: [PATCH] R08 event-driven reversible battery saver without background polling

--- a/src/qml/MainScreen.qml
+++ b/src/qml/MainScreen.qml
@@ -141,8 +141,155 @@
         key: "/org/asteroidos/settings/always-on-display"
         defaultValue: true
     }
 
+    // Optional, resident, event-driven battery savings, R08 only.
+    // No polling, network activity or Bluetooth/Wi-Fi disconnection.
+    Item {
+        id: adaptiveBattery
+        width: 0
+        height: 0
+        property bool changing: false
+        MceBatteryLevel { id: adaptiveGauge }
+        TiltToWake { id: adaptiveTilt }
+        ConfigurationValue {
+            id: adaptiveEnabled
+            key: "/desktop/uglyos/power/adaptive-enabled"
+            defaultValue: false
+            onValueChanged: adaptiveBattery.reconcile()
+        }
+        // Extend the single existing controller; preserve the legacy
+        // 'extended' behavior for existing users already opting in.
+        ConfigurationValue {
+            id: adaptiveProfile
+            key: "/desktop/uglyos/power/adaptive-profile"
+            defaultValue: "extended"
+            onValueChanged: adaptiveBattery.reconcile()
+        }
+        // User-adjustable settings are read only before taking a snapshot.
+        ConfigurationValue {
+            id: adaptiveThreshold
+            key: "/desktop/uglyos/power/low-threshold"
+            defaultValue: "20"
+            onValueChanged: adaptiveBattery.reconcile()
+        }
+        ConfigurationValue {
+            id: adaptiveCustomAod
+            key: "/desktop/uglyos/power/custom-aod"
+            defaultValue: true
+            onValueChanged: adaptiveBattery.reconcile()
+        }
+        ConfigurationValue {
+            id: adaptiveCustomTilt
+            key: "/desktop/uglyos/power/custom-tilt"
+            defaultValue: false
+            onValueChanged: adaptiveBattery.reconcile()
+        }
+        ConfigurationValue {
+            id: adaptiveOriginal
+            key: "/desktop/uglyos/power/adaptive-original"
+            defaultValue: ""
+            onValueChanged: adaptiveBattery.reconcile()
+        }
+        ConfigurationValue {
+            id: adaptiveSolo
+            key: "/desktop/uglyos/solo/previous-controls"
+            defaultValue: ""
+            onValueChanged: adaptiveBattery.reconcile()
+        }
+        function reconcile() {
+            if (changing) return
+            // Read known hardware events, but allow a manual Stop to restore
+            // already-owned changes even if the battery gauge becomes unknown.
+            var amount = adaptiveGauge.percent
+            var validBattery = typeof amount === "number" && isFinite(amount) &&
+                amount >= 0 && amount <= 100
+            var validCharger = typeof mceChargerType.type === "number" &&
+                isFinite(mceChargerType.type)
+            // Solo Saver and nightstand already own these controls.
+            if (adaptiveSolo.value !== "" || nightstandMode.active) return
+            var charging = validCharger &&
+                mceChargerType.type !== MceChargerType.None
+            if (adaptiveOriginal.value !== "") {
+                var previous
+                try { previous = JSON.parse(adaptiveOriginal.value) }
+                catch (error) { return }
+                if (!previous || (previous.version !== 1 && previous.version !== 2) ||
+                    typeof previous.aod !== "boolean" ||
+                    typeof previous.tilt !== "boolean" ||
+                    typeof previous.changedAod !== "boolean" ||
+                    typeof previous.changedTilt !== "boolean") return
+                // Legacy v1 snapshots always restore at 30%. A v2 snapshot
+                // remembers its exact threshold, independent of later edits.
+                var restoreAt = previous.version === 1 ? 30 : previous.restoreAt
+                if ([25, 30, 35].indexOf(restoreAt) < 0) return
+                if (adaptiveEnabled.value === true) {
+                    // Unknown input must not silently interrupt an active
+                    // power-saving session; manual Stop remains available.
+                    if (!validBattery || !validCharger) return
+                    if (!charging && amount < restoreAt) return
+                }
+                changing = true
+                // Never re-disable a control manually turned back on.
+                if (previous.changedAod && alwaysOnDisplay.value === false) {
+                    alwaysOnDisplay.value = previous.aod
+                    displaySettings.lowPowerModeEnabled = previous.aod
+                }
+                if (previous.changedTilt && adaptiveTilt.available &&
+                    adaptiveTilt.enabled === false)
+                    adaptiveTilt.enabled = previous.tilt
+                adaptiveOriginal.value = ""
+                changing = false
+                return
+            }
+            if (adaptiveEnabled.value !== true || !validBattery ||
+                !validCharger || charging) return
+            // Strict allowlists prevent corrupted configuration from choosing
+            // a surprising power policy.
+            if (["connected", "extended", "custom"].indexOf(adaptiveProfile.value) < 0 ||
+                ["15", "20", "25"].indexOf(adaptiveThreshold.value) < 0) return
+            var triggerAt = Number(adaptiveThreshold.value)
+            if (amount > triggerAt) return
+            if (adaptiveProfile.value === "custom" &&
+                (typeof adaptiveCustomAod.value !== "boolean" ||
+                 typeof adaptiveCustomTilt.value !== "boolean")) return
+            var wantsAod = adaptiveProfile.value !== "custom" ||
+                adaptiveCustomAod.value === true
+            var wantsTilt = adaptiveProfile.value === "extended" ||
+                (adaptiveProfile.value === "custom" &&
+                 adaptiveCustomTilt.value === true)
+            var changeAod = wantsAod && alwaysOnDisplay.value === true
+            var changeTilt = wantsTilt && adaptiveTilt.available &&
+                adaptiveTilt.enabled === true
+            if (!changeAod && !changeTilt) return
+            changing = true
+            // Persist before taking control; no polling, radios or root.
+            adaptiveOriginal.value = JSON.stringify({
+                version: 2, aod: !!alwaysOnDisplay.value,
+                tilt: !!adaptiveTilt.enabled, restoreAt: triggerAt + 10,
+                changedAod: changeAod, changedTilt: changeTilt
+            })
+            if (changeAod) {
+                alwaysOnDisplay.value = false
+                displaySettings.lowPowerModeEnabled = false
+            }
+            if (changeTilt) adaptiveTilt.enabled = false
+            changing = false
+        }
+        Connections {
+            target: adaptiveGauge
+            function onPercentChanged() { adaptiveBattery.reconcile() }
+        }
+        Connections {
+            target: mceChargerType
+            function onTypeChanged() { adaptiveBattery.reconcile() }
+        }
+        Connections {
+            target: nightstandMode
+            function onActiveChanged() { adaptiveBattery.reconcile() }
+        }
+        Component.onCompleted: reconcile()
+    }
     Item {
         id: burnInProtectionManager
 
         // Maximum offset before components from other grid becomes visible.
